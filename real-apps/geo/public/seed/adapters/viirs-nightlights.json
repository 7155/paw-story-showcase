{
  "adapter": {
    "schemaVersion": "scoutpi.earth.adapter.v1",
    "datasetId": "viirs-nightlights",
    "title": "VIIRS Monthly Nighttime Lights",
    "provider": "NOAA",
    "collectionId": "NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG",
    "documentationUrl": "https://developers.google.com/earth-engine/datasets/catalog/NOAA_VIIRS_DNB_MONTHLY_V1_VCMSLCFG",
    "roles": [
      "human_activity",
      "night_activity",
      "urbanization"
    ],
    "startYear": 2012,
    "scaleMeters": 500,
    "cadence": "monthly",
    "limitations": [
      "Night lights are not GDP.",
      "Outliers, background and temporary events require control."
    ],
    "analysis": {
      "metric": "band_mean",
      "bands": [
        "avg_rad"
      ],
      "outputName": "night_light_mean",
      "visualization": {
        "min": 0,
        "max": 50,
        "palette": [
          "081d58",
          "225ea8",
          "41b6c4",
          "c7e9b4",
          "ffffd9"
        ]
      }
    },
    "guardrails": [
      {
        "id": "proxy-boundary",
        "severity": "blocking",
        "message": "Nighttime lights cannot be reported as GDP or economic output.",
        "resolution": "Describe it as an activity proxy and add independent evidence.",
        "claimRule": {
          "forbiddenTerms": [
            "GDP",
            "economic output"
          ],
          "requiredQualifiers": [
            "proxy",
            "activity indicator",
            "nighttime light"
          ]
        }
      }
    ]
  },
